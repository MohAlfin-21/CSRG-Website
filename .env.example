# ============================================================
# CSRG — Root Environment File Template (Docker Compose)
# Salin file ini ke .env dan isi nilai yang sesuai.
# JANGAN PERNAH commit .env ke version control!
# ============================================================

# ─── MongoDB ────────────────────────────────────────────────
MONGO_ROOT_USERNAME=csrg_admin
# Generate dengan: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
MONGO_ROOT_PASSWORD=GANTI_PASSWORD_MONGO_KUAT
MONGO_DATABASE=csrg_database

# ─── MinIO ──────────────────────────────────────────────────
# Generate dengan: python3 -c "import secrets; print('csrg_' + secrets.token_hex(4))"
MINIO_ROOT_USER=GANTI_USER_MINIO
# Generate dengan: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MINIO_ROOT_PASSWORD=GANTI_PASSWORD_MINIO_KUAT
