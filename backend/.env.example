# ============================================================
# CSRG Backend — Environment Variables Template
# Salin file ini ke .env dan isi nilai yang sesuai
# JANGAN PERNAH commit .env ke version control!
# ============================================================

# ─── MongoDB ─────────────────────────────────────────────────
# Format dengan auth: mongodb://user:pass@host:port/dbname?authSource=admin
# Docker Compose (dengan auth): mongodb://csrg_admin:GANTI_PASS@mongo:27017/csrg_database?authSource=admin
# Local dev (tanpa auth):       mongodb://localhost:27017
MONGO_URL=mongodb://csrg_admin:GANTI_PASSWORD_KUAT@mongo:27017/csrg_database?authSource=admin
DB_NAME=csrg_database

# ─── CORS ────────────────────────────────────────────────────
# Daftar origin yang diizinkan, pisahkan dengan koma
# Production: https://csrg.pens.ac.id,https://www.csrg.pens.ac.id
# Local dev:  http://localhost:3000,http://localhost:5173
# JANGAN gunakan * di production!
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── JWT Authentication ───────────────────────────────────────
# Generate dengan: python3 -c "import secrets; print(secrets.token_hex(32))"
# WAJIB diganti sebelum production!
JWT_SECRET_KEY=GANTI_DENGAN_RANDOM_HEX_32_BYTES

# Masa berlaku token dalam menit (60 = 1 jam, JANGAN lebih dari 480)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Swagger / ReDoc API Docs ─────────────────────────────────
# Set ke false di production untuk menyembunyikan API documentation
ENABLE_API_DOCS=false

# ─── Admin Cookie ─────────────────────────────────────────────
# Set ke "true" di production (HTTPS) agar cookie hanya dikirim via TLS
COOKIE_SECURE=false

# ─── Rate Limiter ─────────────────────────────────────────────
# Daftar IP reverse proxy terpercaya (pisahkan koma), mis: 172.18.0.1
# X-Forwarded-For hanya dipercaya dari IP ini (mencegah IP spoofing)
TRUSTED_PROXY_IPS=

# ─── MinIO / S3 Object Storage ───────────────────────────────
# Docker Compose: minio:9000 (nama service docker internal)
# Production:     <ip-server>:9000 atau domain MinIO/S3
MINIO_ENDPOINT=minio:9000

# Endpoint yang diakses browser klien (bisa berbeda dengan internal endpoint)
MINIO_PUBLIC_ENDPOINT=localhost:9000

# Credentials MinIO — HARUS sama dengan MINIO_ROOT_USER/PASSWORD di root .env
# Generate dengan random values yang kuat
# JANGAN gunakan minioadmin/miniopassword di production!
MINIO_ACCESS_KEY=GANTI_ACCESS_KEY_KUAT
MINIO_SECRET_KEY=GANTI_SECRET_KEY_KUAT

MINIO_BUCKET=csrg-media
# Set ke "true" jika MinIO menggunakan HTTPS
MINIO_USE_SSL=false
